    {
      "version": "3.1.7",
      "tag": "3.1.7",
      "releaseDate": "2026-04-08",
      "releaseDateFormatted": {
        "fr": "8 avril 2026",
        "en": "Apr 8, 2026"
      },
      "changelog": {
        "summary": "This update expands display management across both the launcher and individual instances while making the related interface more complete and easier to use. It also introduces a new Launch Acceleration system and replaces legacy divizion.fr download endpoints with GitHub Releases URL.",
        "added": [
          "Display preferences now support global defaults and per-instance overrides for hardware acceleration, view mode, custom dimensions, game resolution, and fullscreen behavior",
          "The Instance Manager now includes a dedicated Display tab with presets, custom resolution inputs, and a fullscreen toggle",
          "New Launch Acceleration system designed to improve startup and relaunch performance without sacrificing control",
          "New configuration fields for acceleration presets, parallel asset loading, Java version detection skipping, classpath caching, lazy native extraction, metadata preloading, and restart-sensitive disable logic",
          "New authentication reconnect toast with dedicated styling and retry logic so token refresh failures can trigger recovery attempts without immediately deleting the connected account"
        ],
        "changed": [
          "Replaced legacy divizion.fr download and fallback endpoints with the GitHub Releases URL across both renderer and backend layers",
          "The activity UI has been refreshed with a new notification widget built around a vertical step layout and SVG progress ring, replacing the previous horizontal stepper",
          "The default launch acceleration mode has been adjusted to normal for a safer baseline experience"
        ],
        "improved": [
          "Persistent storage handled through ConfigManager and runtime handling updated so ProcessBuilder applies each instance's own width, height, and fullscreen values correctly",
          "Backend updates add in-memory cache reuse, earlier asset loading, and crash-aware suggestions that can temporarily disable acceleration after instability is detected"
        ]
      },
